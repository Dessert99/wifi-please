{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wifi-please-server",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-15",
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	// 설치별 제한을 주로 사용하고 같은 카페의 공유 IP는 보조적으로 제한한다.
	"ratelimits": [
		{
			"name": "SCAN_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	"vars": {
		"SCAN_MODE": "production",
		"PLAY_PACKAGE_NAME": "com.wifiplease.app",
		"SCAN_INSTALL_DAILY": "10",
		"SCAN_INSTALL_MINUTE": "3",
		"SCAN_GLOBAL_DAILY": "300",
		"SCAN_GLOBAL_MONTHLY": "3000"
	},
	"durable_objects": { "bindings": [{ "name": "SCAN_QUOTA", "class_name": "ScanQuota" }] },
	"migrations": [{ "tag": "v1-scan-quota", "new_sqlite_classes": ["ScanQuota"] }]
}
